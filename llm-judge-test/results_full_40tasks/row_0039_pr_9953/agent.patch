+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PaypalExtendedAuthStatus {
+    Created,
+    Captured,
+    Denied,
+    PartiallyCaptured,
+    Voided,
+    Pending,
+}
+
+impl From<PaypalExtendedAuthStatus> for common_enums::AuthorizationStatus {
+    fn from(item: PaypalExtendedAuthStatus) -> Self {
+        match item {
+            PaypalExtendedAuthStatus::Created
+            | PaypalExtendedAuthStatus::Captured
+            | PaypalExtendedAuthStatus::PartiallyCaptured => Self::Success,
+            PaypalExtendedAuthStatus::Pending => Self::Processing,
+            PaypalExtendedAuthStatus::Denied | PaypalExtendedAuthStatus::Voided => Self::Failure,
+        }
+    }
+}
+
+impl From<PaypalExtendedAuthStatus> for common_enums::AttemptStatus {
+    fn from(item: PaypalExtendedAuthStatus) -> Self {
+        match item {
+            PaypalExtendedAuthStatus::Created
+            | PaypalExtendedAuthStatus::Captured
+            | PaypalExtendedAuthStatus::PartiallyCaptured => Self::Authorized,
+            PaypalExtendedAuthStatus::Pending => Self::Pending,
+            PaypalExtendedAuthStatus::Denied | PaypalExtendedAuthStatus::Voided => Self::Failure,
+        }
+    }
+}
+
+fn is_extend_authorization_applied(
+    item: PaypalExtendedAuthStatus,
+) -> Option<common_types::primitive_wrappers::ExtendedAuthorizationAppliedBool> {
+    match item {
+        PaypalExtendedAuthStatus::Created
+        | PaypalExtendedAuthStatus::Captured
+        | PaypalExtendedAuthStatus::PartiallyCaptured => {
+            Some(common_types::primitive_wrappers::ExtendedAuthorizationAppliedBool::from(true))
+        }
+        PaypalExtendedAuthStatus::Pending => None,
+        PaypalExtendedAuthStatus::Denied | PaypalExtendedAuthStatus::Voided => {
+            Some(common_types::primitive_wrappers::ExtendedAuthorizationAppliedBool::from(false))
+        }
+    }
+}
+
