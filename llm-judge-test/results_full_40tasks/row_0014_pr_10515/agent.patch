+/// Parses the redirect response payload from the request body, handling both JSON and
+/// form-urlencoded content types with various character encodings.
+///
+/// Upstream providers may send redirect responses with different content types and character
+/// encodings (e.g., UTF-8, ISO-8859-1, Windows-1252). This function robustly handles all
+/// variants by:
+/// - Attempting to parse the body as JSON first
+/// - Falling back to form-urlencoded parsing with encoding detection
+/// - Using encoding_rs to handle non-UTF-8 encodings gracefully
+pub fn parse_redirect_response_payload(
+    req: &actix_web::HttpRequest,
+    body: actix_web::web::Bytes,
+) -> Option<serde_json::Value> {
+    if body.is_empty() {
+        return None;
+    }
+
+    // Try parsing as JSON first (most common case)
+    if let Ok(json_value) = serde_json::from_slice::<serde_json::Value>(&body) {
+        return Some(json_value);
+    }
+
+    // Get content type from headers to detect encoding
+    let content_type = req
+        .headers()
+        .get(actix_web::http::header::CONTENT_TYPE)
+        .and_then(|ct| ct.to_str().ok());
+
+    // Determine the character encoding from content type or default to UTF-8
+    let encoding = content_type
+        .and_then(parse_encoding_from_content_type)
+        .unwrap_or(encoding_rs::UTF_8);
+
+    // Decode bytes using detected encoding
+    let (decoded_str, _, had_errors) = encoding.decode(&body);
+
+    if had_errors {
+        logger::warn!(
+            "Encoding errors encountered while decoding redirect response payload, attempting fallback parsing"
+        );
+    }
+
+    let body_str = decoded_str.as_ref();
+
+    // Try parsing decoded string as JSON
+    if let Ok(json_value) = serde_json::from_str::<serde_json::Value>(body_str) {
+        return Some(json_value);
+    }
+
+    // Try parsing as form-urlencoded data
+    if let Ok(form_data) = serde_urlencoded::from_str::<std::collections::HashMap<String, String>>(
+        body_str,
+    ) {
+        return serde_json::to_value(form_data).ok();
+    }
+
+    // If all parsing attempts fail, return the raw body as a string value
+    logger::warn!(
+        "Failed to parse redirect response payload as structured data, returning as string"
+    );
+    Some(serde_json::Value::String(body_str.to_string()))
+}
+
+/// Extracts the character encoding from a Content-Type header value.
+///
+/// Supports common encodings used by upstream payment providers.
+fn parse_encoding_from_content_type(content_type: &str) -> Option<&'static encoding_rs::Encoding> {
+    // Extract charset parameter from content type
+    let charset = content_type
+        .to_lowercase()
+        .split(';')
+        .find_map(|part| {
+            let part = part.trim();
+            if part.starts_with("charset=") {
+                Some(part["charset=".len()..].trim().trim_matches('"'))
+            } else {
+                None
+            }
+        });
+
+    match charset {
+        Some("utf-8") => Some(encoding_rs::UTF_8),
+        Some("iso-8859-1") | Some("latin1") | Some("latin-1") => Some(encoding_rs::WINDOWS_1252),
+        Some("iso-8859-15") | Some("latin9") | Some("latin-9") => {
+            Some(encoding_rs::ISO_8859_15)
+        }
+        Some("windows-1252") | Some("cp1252") => Some(encoding_rs::WINDOWS_1252),
+        Some("iso-8859-10") | Some("latin6") | Some("latin-6") => {
+            Some(encoding_rs::ISO_8859_10)
+        }
+        Some(other) => {
+            // Try to get encoding from encoding_rs by label
+            encoding_rs::Encoding::for_label(other.as_bytes())
+        }
+        None => None,
+    }
+}
